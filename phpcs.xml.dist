<?xml version="1.0"?>
<ruleset name="blocLabs SSI Login">
	<description>WordPress coding standards, PSR-4 file names, PHP 8.1+.</description>

	<file>.</file>
	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>

	<config name="testVersion" value="8.1-"/>
	<config name="minimum_wp_version" value="6.6"/>

	<rule ref="PHPCompatibilityWP"/>

	<rule ref="WordPress-Extra">
		<!-- PSR-4: class files are named after their class. -->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
	<!-- Typed signatures carry the types; docblocks explain intent where it is not obvious. -->

	<!-- Unit tests stub a few WordPress functions in the global namespace. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>
	<rule ref="PHPCompatibility.Miscellaneous.ValidIntegers.HexNumericStringFound">
		<exclude-pattern>/tests/*</exclude-pattern>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array" value="bloclabs-ssi-login"/>
		</properties>
	</rule>

	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array" value="bloclabs_ssi,BlocLabs\SsiLogin,BLOCLABS_SSI"/>
		</properties>
	</rule>
</ruleset>
